generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id             String    @id @default(cuid())
  nom            String
  prenom         String
  email          String    @unique
  motDePasseHash String
  dateCreation   DateTime  @default(now())
  dateMiseAJour  DateTime  @updatedAt

  membresFoyers  FoyerMembre[] @relation("MembreFoyer")
  evenements     Evenement[]   @relation("EvenementCreateur")
  invitations    Invitation[]  @relation("InvitationDestinataire")
  messages       Message[]     @relation("MessageAuteur")
}

model Foyer {
  id             String   @id @default(cuid())
  nom            String
  codeInvitation String   @unique
  dateCreation   DateTime @default(now())
  dateMiseAJour  DateTime @updatedAt

  membres        FoyerMembre[] @relation("MembreFoyer")
  evenements     Evenement[]   @relation("FoyerEvenements")
  taches         Tache[]       @relation("FoyerTaches")
  conversations  Conversation[] @relation("FoyerConversations")
}

model FoyerMembre {
  id            String   @id @default(cuid())
  foyerId       String
  utilisateurId String
  role          String
  dateCreation  DateTime @default(now())

  foyer         Foyer      @relation("MembreFoyer", fields: [foyerId], references: [id], onDelete: Cascade)
  utilisateur   Utilisateur @relation("MembreFoyer", fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([foyerId, utilisateurId])
}

model Evenement {
  id            String    @id @default(cuid())
  foyerId       String
  createurId    String
  type          String    @default("evenement")
  titre         String
  description   String?
  dateDebut     DateTime
  dateFin       DateTime?
  lieu          String?
  dateCreation  DateTime  @default(now())
  dateMiseAJour DateTime  @updatedAt

  foyer         Foyer      @relation("FoyerEvenements", fields: [foyerId], references: [id], onDelete: Cascade)
  createur      Utilisateur @relation("EvenementCreateur", fields: [createurId], references: [id], onDelete: Restrict)
  invitations   Invitation[] @relation("InvitationEvenement")
}

model Invitation {
  id           String   @id @default(cuid())
  evenementId  String
  destinataireId String
  statut       String
  dateCreation DateTime @default(now())
  dateReponse  DateTime?

  evenement    Evenement    @relation("InvitationEvenement", fields: [evenementId], references: [id], onDelete: Cascade)
  destinataire Utilisateur  @relation("InvitationDestinataire", fields: [destinataireId], references: [id], onDelete: Cascade)

  @@unique([evenementId, destinataireId])
}

model Tache {
  id            String    @id @default(cuid())
  foyerId       String
  titre         String
  description   String?
  assigneA      String?
  statut        String
  dateEcheance  DateTime?
  dateCreation  DateTime  @default(now())
  dateMiseAJour DateTime  @updatedAt

  foyer         Foyer     @relation("FoyerTaches", fields: [foyerId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String   @id @default(cuid())
  foyerId       String
  titre         String
  dateCreation  DateTime @default(now())
  dateMiseAJour DateTime @updatedAt

  foyer         Foyer    @relation("FoyerConversations", fields: [foyerId], references: [id], onDelete: Cascade)
  messages      Message[] @relation("MessageConversation")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  auteurId       String
  contenu        String
  dateCreation   DateTime @default(now())

  conversation   Conversation @relation("MessageConversation", fields: [conversationId], references: [id], onDelete: Cascade)
  auteur         Utilisateur  @relation("MessageAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
}
