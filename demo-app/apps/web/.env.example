# Démonstration du lancement automatique — variables d'environnement de l'application web.

# Clé de chiffrement des sessions NextAuth (générer une valeur avec : openssl rand -base64 32).
AUTH_SECRET="<remplacer-par-une-cle-generee>"

# Origine publique de l'application en développement local.
AUTH_URL="http://localhost:3000"

# Connexion à la base SQLite au runtime. Le fichier dev.db vit dans
# packages/database/prisma/ (voir packages/database/.env.example).
DATABASE_URL="file:./dev.db"

# Reproduis ce contenu dans apps/web/.env.local pour ton environnement de travail.