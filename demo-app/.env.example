# Démonstration du lancement automatique — variables d'environnement du monorepo.

# Connexion à la base SQLite. Le chemin est relatif au fichier du schéma
# (packages/database/prisma/schema.prisma) : le fichier dev.db est créé
# dans packages/database/prisma/.
DATABASE_URL="file:./dev.db"

# Outillage Prisma : reproduis ce fichier en packages/database/.env.
# Runtime Next.js : reproduis-le en apps/web/.env.local.

# Clé de chiffrement des sessions NextAuth (générer : openssl rand -base64 32).
AUTH_SECRET=""

# Origine publique de l'application en développement local.
AUTH_URL="http://localhost:3000"